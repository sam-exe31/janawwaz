# Server
PORT=8080
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=mysql
DB_NAME=janawwaz_db

# Security & JWT
JWT_SECRET=super_secret_jwt_key_at_least_32_bytes_long_civic_platform!
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_bytes_long_civic_platform!
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
COOKIE_SECRET=civic_cookie_secret_key_32bytes_min

# Initial Admin Credentials
ADMIN_EMAIL=admin@civic.gov.in
ADMIN_INITIAL_PASSWORD=Admin@123456

# OTP Configuration
OTP_MODE=DUMMY
OTP_DUMMY_CODE=123456
OTP_WHITELIST=+919000000001,+919000000002,+919000000003,+919000000004,+919000000005,+919000000006,+919000000007,+919000000008,+919000000009,+919000000010

# Citizen Limits
CITIZEN_MAX_REQUESTS_PER_DAY=3
CITIZEN_COOLDOWN_MINUTES=10
CITIZEN_MAX_PHOTOS=5

# Screening Config
SCREENING_GENUINE_THRESHOLD=0.60
SCREENING_JUNK_THRESHOLD=0.15
SCREENING_EXIF_MAX_DISTANCE_METERS=300
SCREENING_WEIGHT_CATEGORY=0.40
SCREENING_WEIGHT_SEVERITY=0.40
SCREENING_WEIGHT_CLUSTER=0.20

# Cluster Config
CLUSTER_RADIUS_METERS=100
CLUSTER_MAX_SIZE_FOR_PRIORITY=10

# Request & NGO Limits
REQUEST_REJECT_THRESHOLD=3
NGO_MAX_CLAIMS_PER_DAY=5
NGO_MAX_CONCURRENT_CLAIMS=5
HELPER_MAX_ACTIVE_ASSIGNMENTS=3

# SLA & Ratings
SLA_ESCALATION_HOURS=48
RATING_WINDOW_DAYS=14

# NGO Ranking Weights
RANK_W1=1.0
RANK_W2=10
RANK_W3=5
RANK_W4=15
RANK_W5=0.5

# Volunteer & Reward Limits
VOLUNTEER_EASY_BUDGET_MAX=2000
VOLUNTEER_MAX_ACTIONS_PER_DAY=20
REWARD_DAILY_AUTO_CAP=50
SESSION_ACTIVE_WINDOW_MINUTES=15

# Gemini AI
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2

# Geo Bounding Box: [minLat, minLng, maxLat, maxLng] for India
GEO_BBOX=6.0,68.0,37.5,98.0
