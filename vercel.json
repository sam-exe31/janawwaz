{
  "version": 2,
  "buildCommand": "cd janavaaj-web && npm install && npm run build",
  "outputDirectory": "janavaaj-web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
